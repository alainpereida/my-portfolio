# Configuración del servidor para pereidanet.me (Hostinger / LiteSpeed).
# Vive en public/ para que Astro lo copie a dist/ en cada build.

Options -Indexes

# --- Redirecciones -----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.pereidanet.me -> https://pereidanet.me en un solo salto (va primero para
  # que http://www no pase antes por https://www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Forzar HTTPS (considera el CDN, que envía X-Forwarded-Proto)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Compresión --------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml font/ttf
</IfModule>

# --- Caché -------------------------------------------------------------------
<IfModule mod_headers.c>
  # HTML: siempre revalidar para que los cambios se vean al publicar
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Archivos de Astro con hash en el nombre (ej. index.DzjDLvg1.css):
  # nunca cambian, se pueden guardar un año
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fuentes, favicon, imágenes y CVs: una semana
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|ico|ttf|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Seguridad básica
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
