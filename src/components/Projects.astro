---
import { getI18N } from "@/i18n/";
import Icon from "@/icons/Icon.astro";
import SheetSection from "./SheetSection.astro";

const { currentLocale = "es" } = Astro;
const p = getI18N({ currentLocale }).PROJECTS;
---

<SheetSection id="projects" title={p.title} intro={p.intro} wide>
  <ol class="border-t rule-strong">
    {
      p.items.map((item, i) => (
        <li class="project grid gap-6 border-b hairline py-8 md:grid-cols-12 md:gap-10 md:py-10">
          <figure class="md:col-span-5">
            <div
              class={`drafting-grid flex aspect-[16/10] justify-center overflow-hidden border hairline ${
                item.kind === "mobile" ? "items-start px-4 pt-5 sm:px-6 sm:pt-6" : "items-center p-4 sm:p-6"
              }`}
            >
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                decoding="async"
                width={item.kind === "mobile" ? 1080 : 2560}
                height={item.kind === "mobile" ? 2400 : 1273}
                class={`project-shot border rule-strong shadow-[0_12px_28px_-16px_rgb(0_0_0/0.55)] transition-transform duration-500 ${
                  item.kind === "mobile" ? "w-[62%] max-w-none" : "max-h-full w-full object-contain"
                }`}
              />
            </div>
            <figcaption class="mt-2 text-sm text-muted">
              {p.labels.fig} {i + 2} — {item.title}
            </figcaption>
          </figure>

          <div class="md:col-span-7">
            <h3 class="text-[clamp(1.6rem,3vw,2.25rem)] font-bold leading-tight tracking-[-0.02em]">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener" class="group/link inline-flex items-baseline gap-2 link-ink">
                  {item.title}
                  <Icon
                    name="arrow-up-right"
                    size={22}
                    class="shrink-0 translate-y-0.5 text-signal-ink transition-transform group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5"
                  />
                  <span class="sr-only">({p.labels.visit})</span>
                </a>
              ) : (
                item.title
              )}
            </h3>
            <p class="mt-3 max-w-[40rem] text-lg leading-relaxed" style="text-wrap: pretty;">
              {item.description}
            </p>
            <table class="mt-6 w-full max-w-[40rem] border-t rule-strong text-left">
              <tbody>
                <tr class="border-b hairline">
                  <th scope="row" class="w-1/4 py-2 pr-4 align-top font-light text-muted">{p.labels.type}</th>
                  <td class="py-2">{item.type}</td>
                </tr>
                {item.client && (
                  <tr class="border-b hairline">
                    <th scope="row" class="w-1/4 py-2 pr-4 align-top font-light text-muted">{p.labels.client}</th>
                    <td class="py-2">{item.client}</td>
                  </tr>
                )}
                <tr class="border-b hairline">
                  <th scope="row" class="w-1/4 py-2 pr-4 align-top font-light text-muted">{p.labels.stack}</th>
                  <td class="py-2 font-bold">{item.technologies.join(" · ")}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </li>
      ))
    }
  </ol>
</SheetSection>

<style>
  .project:hover .project-shot {
    transform: translateY(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .project:hover .project-shot {
      transform: none;
    }
  }
</style>
