---
import { getI18N } from "@/i18n/";
import { PART_NUMBER } from "@/data/stack";

const { currentLocale = "es" } = Astro;
const i18n = getI18N({ currentLocale });
---

<footer>
  <div
    class="mx-auto flex max-w-sheet flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6 text-sm text-muted sm:px-6"
  >
    <span>© 2026 {i18n.FOOTER.rights} · pereidanet.me</span>
    <span>{i18n.FOOTER.built}</span>
    <span>{PART_NUMBER} · {i18n.SHEET.page}</span>
  </div>
</footer>
