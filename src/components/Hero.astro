---
import { getI18N } from "@/i18n/";
import Icon from "@/icons/Icon.astro";
import { PART_NUMBER } from "@/data/stack";

const { currentLocale = "es" } = Astro;
const i18n = getI18N({ currentLocale });
const h = i18n.HERO;
const rev = `${i18n.SHEET.rev} ${i18n.EXPERIENCE.items.length}.0`;
---

<section id="top" class="border-b rule-strong">
  <div class="mx-auto max-w-sheet px-4 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-b hairline py-2.5 text-sm text-muted">
      <span>{i18n.SHEET.kind} · {PART_NUMBER}</span>
      <span>{rev} · 2026</span>
    </div>

    <div class="grid gap-10 py-10 md:py-14 lg:grid-cols-12 lg:gap-12 lg:py-16">
      <div class="lg:col-span-7 lg:pr-4">
        <h1
          class="hero-name font-bold leading-[0.92] tracking-[-0.035em] text-[clamp(3rem,9vw,6rem)]"
          style="text-wrap: balance;"
        >
          {h.name}
        </h1>
        <p class="mt-5 text-xl font-bold sm:text-2xl">
          <span class="mr-2 inline-block h-3 w-3 bg-signal align-[0.05em]" aria-hidden="true"></span>{h.role}
        </p>
        <p class="mt-4 max-w-[38rem] text-lg leading-relaxed text-muted sm:text-xl" style="text-wrap: pretty;">
          {h.summary}
        </p>

        <table class="mt-8 w-full max-w-[38rem] border-t rule-strong text-left">
          <caption class="sr-only">{h.specsLabel}</caption>
          <tbody>
            {
              h.specs.map((s) => (
                <tr class="border-b hairline">
                  <th scope="row" class="w-[38%] py-2.5 pr-4 align-top font-light text-muted">
                    {s.k}
                  </th>
                  <td class="py-2.5 font-bold">{s.v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={i18n.CV_URL} target="_blank" rel="noopener" class="btn-primary">
            <Icon name="download" />
            {h.ctaCv}
          </a>
          <a href="#contact" class="btn-secondary">
            <Icon name="mail" />
            {h.ctaContact}
          </a>
          <div class="ml-1 flex items-center">
            <a
              href="https://github.com/alainpereida"
              target="_blank"
              rel="noopener"
              class="p-2.5 text-ink transition-colors hover:text-signal-ink"
              aria-label="GitHub"
            >
              <Icon name="github" size={22} />
            </a>
            <a
              href="https://www.linkedin.com/in/alain-pereida-prado-64b45b1b7"
              target="_blank"
              rel="noopener"
              class="p-2.5 text-ink transition-colors hover:text-signal-ink"
              aria-label="LinkedIn"
            >
              <Icon name="linkedin" size={22} />
            </a>
          </div>
        </div>
      </div>

      <figure class="lg:col-span-5">
        <div class="drafting-grid relative border hairline p-5 pb-6 sm:p-8">
          <!-- horizontal dimension -->
          <div class="dim-h mb-3 flex items-center gap-2 text-xs font-bold text-signal-ink" aria-hidden="true">
            <span class="tick"></span><span class="line"></span>
            <span class="whitespace-nowrap">{h.dimTop}</span>
            <span class="line"></span><span class="tick"></span>
          </div>
          <div class="flex gap-3">
            <div class="relative mx-auto aspect-square w-full max-w-[22rem]">
              <img
                src="/img/alain.png"
                alt={h.photoAlt}
                width="1080"
                height="1080"
                fetchpriority="high"
                class="h-full w-full border-2 rule-strong object-cover"
              />
              <span class="corner left-0 top-0" aria-hidden="true"></span>
              <span class="corner right-0 top-0 rotate-90" aria-hidden="true"></span>
              <span class="corner bottom-0 right-0 rotate-180" aria-hidden="true"></span>
              <span class="corner bottom-0 left-0 -rotate-90" aria-hidden="true"></span>
            </div>
            <!-- vertical dimension -->
            <div class="dim-v flex flex-col items-center gap-2 text-xs font-bold text-signal-ink" aria-hidden="true">
              <span class="tick"></span><span class="line"></span>
              <span class="whitespace-nowrap [writing-mode:vertical-rl]">{h.dimSide}</span>
              <span class="line"></span><span class="tick"></span>
            </div>
          </div>
        </div>
        <figcaption class="mt-3 text-sm text-muted">{h.figure}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .dim-h .line {
    flex: 1;
    height: 1px;
    background: currentColor;
  }
  .dim-h .tick {
    width: 1px;
    height: 12px;
    background: currentColor;
  }
  .dim-v .line {
    flex: 1;
    width: 1px;
    background: currentColor;
  }
  .dim-v .tick {
    height: 1px;
    width: 12px;
    background: currentColor;
  }
  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    margin: -7px;
    border-left: 2px solid rgb(var(--signal));
    border-top: 2px solid rgb(var(--signal));
  }
</style>
